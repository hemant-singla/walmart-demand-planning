model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DataFolder", "Dates", "Series", "AsOf", "ReviewList", "ForecastBand", "SalesHistory", "ModelComparison", "IntervalCoverage", "RuleWeekly", "RuleSummary", "DataChecks", "Strata", "CtxStore", "CtxDept", "CtxMonthly", "CtxWeekday", "CtxSnap", "CtxEvents", "CtxPareto", "CtxZeroShare", "CtxPanelVsM5", "CtxPrice", "CtxDaily"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table Dates
ref table Series
ref table AsOf
ref table ReviewList
ref table ForecastBand
ref table SalesHistory
ref table ModelComparison
ref table IntervalCoverage
ref table RuleWeekly
ref table RuleSummary
ref table DataChecks
ref table Strata
ref table CtxStore
ref table CtxDept
ref table CtxMonthly
ref table CtxWeekday
ref table CtxSnap
ref table CtxEvents
ref table CtxPareto
ref table CtxZeroShare
ref table CtxPanelVsM5
ref table CtxPrice
ref table CtxDaily

ref cultureInfo en-US

