	partition ModelComparison = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "ModelComparison.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"mean_rmsse", "median_rmsse", "wape", "bias", "actual_units", "rmsse_undefined", "segment_order"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"period", type text}, {"model", type text}, {"segment_type", type text}, {"segment", type text}, {"mean_rmsse", type number}, {"median_rmsse", type number}, {"wape", type number}, {"bias", type number}, {"actual_units", type number}, {"rmsse_undefined", Int64.Type}, {"segment_order", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

