table ModelComparison
	lineageTag: c8a83831-f2aa-2baa-5157-2f08ec515609

	measure 'Mean RMSSE' = AVERAGE(ModelComparison[mean_rmsse])
		formatString: 0.000
		lineageTag: 42708298-28af-7a7a-6f0e-a9bb4e28f497

	measure 'WAPE (avg)' = AVERAGE(ModelComparison[wape])
		formatString: 0.0%
		lineageTag: cfdbc397-03e5-9445-e451-832d6c4deba8

	measure 'Bias (avg)' = AVERAGE(ModelComparison[bias])
		formatString: +0.0%;-0.0%
		lineageTag: 6dfccd35-dd95-f627-50e5-f18c5bd92338

	measure 'Holdout RMSSE LightGBM' = CALCULATE(AVERAGE(ModelComparison[mean_rmsse]), ModelComparison[period] = "Holdout", ModelComparison[model] = "LightGBM", ModelComparison[segment_type] = "all")
		formatString: 0.000
		lineageTag: 28150e20-e651-eb2b-d9c5-70fb64f2a979

	measure 'Holdout RMSSE ETS' = CALCULATE(AVERAGE(ModelComparison[mean_rmsse]), ModelComparison[period] = "Holdout", ModelComparison[model] = "ETS", ModelComparison[segment_type] = "all")
		formatString: 0.000
		lineageTag: 48f0d2d8-1bbc-0f74-a3bd-021934be10e0

	measure 'Holdout RMSSE naive' = CALCULATE(AVERAGE(ModelComparison[mean_rmsse]), ModelComparison[period] = "Holdout", ModelComparison[model] = "Seasonal naive", ModelComparison[segment_type] = "all")
		formatString: 0.000
		lineageTag: d679e62f-49e8-077f-9ca8-885bbcd998cb

