table RuleWeekly
	lineageTag: 0d7d8631-2d99-7f29-c66f-f798e82c8be8

	measure 'Captured share of next-week error' = AVERAGE(RuleWeekly[captured_ae_share])
		formatString: 0.0%
		lineageTag: 9e2cf2f8-105b-2849-7dfd-7cc694295278

	measure 'Precision for large errors' = AVERAGE(RuleWeekly[precision])
		formatString: 0%
		lineageTag: 34a79617-23f2-8131-4424-e4e0f324ca52

	column rule
		dataType: string
		lineageTag: ed90e525-8daa-5be7-8b1f-4025a21e171e
