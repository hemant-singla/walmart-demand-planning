	partition RuleWeekly = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "RuleWeekly.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Blanks = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"origin", "K", "captured_ae_share", "captured_ae_units", "total_ae_units", "captured_ne_share", "precision", "recall", "events"}),
				    Typed = Table.TransformColumnTypes(Blanks, {{"rule", type text}, {"origin", Int64.Type}, {"K", Int64.Type}, {"captured_ae_share", type number}, {"captured_ae_units", type number}, {"total_ae_units", type number}, {"captured_ne_share", type number}, {"precision", type number}, {"recall", type number}, {"events", Int64.Type}, {"period", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

